# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL this PulseOS instance is deployed at (used to build tracker.js src examples)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Podbean Developer App (developers.podbean.com) -- server-side only, never NEXT_PUBLIC_
PODBEAN_CLIENT_ID=
PODBEAN_CLIENT_SECRET=

# Internal secret protecting /api/cron/* and /api/admin/* routes -- server-side only, never NEXT_PUBLIC_
CRON_SECRET=
